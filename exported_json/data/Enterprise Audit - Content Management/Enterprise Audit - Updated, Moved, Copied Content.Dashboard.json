          "transient": false,
          "queryString": "_index=sumologic_audit_events _sourceCategory=content and (ContentUpdated OR ContentMoved OR ContentCopied)\n| json \"eventName\", \"eventTime\", \"adminMode\", \"contentIdentity.name\", \"contentIdentity.type\", \"operator.email\", \"operator.id\", \"operator.sourceIp\" as EventName, EventTime, AdminMode, ContentName, ContentType, UserEmail, UserId, UserIp nodrop\n| where EventName in (\"ContentUpdated\", \"ContentMoved\", \"ContentCopied\")\n| json \"copiedTo.contentIdentity.name\" as TargetContentName nodrop\n| json \"origin.name\", \"destination.name\" as SourceFolder, TargetFolder nodrop\n| if(isNull(TargetContentName), \"-\", TargetContentName) as CopiedContentName\n| if(isNull(SourceFolder), \"-\", SourceFolder) as OriginFolderName\n| if(isNull(TargetFolder), \"-\", TargetFolder) as DestinationFolderName\n| where  UserIp matches \"{{UserIp}}\" and  EventName matches \"{{EventName}}\"\n|count by EventName, EventTime, AdminMode, ContentName, ContentType,UserEmail, UserId, UserIp, CopiedContentName, OriginFolderName, DestinationFolderName\n| sort by EventTime\n| fields - _count, UserId\n| limit 10\n",
          "queryType": "Logs",
          "queryKey": "A",
