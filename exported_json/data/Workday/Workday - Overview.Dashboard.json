      "key": "panelPANE-25CCA410A5BF6840",
      "title": "Anomaly Detection On Failed/Total Logins",
      "visualSettings": "{\"title\":{\"fontSize\":16},\"general\":{\"type\":\"line\",\"displayType\":\"default\",\"outlierBandColor\":\"#FDECF5\",\"outlierBandMarkerColor\":\"#ED3CPE\",\"outlierBandFillOpacity\":0.15,\"outlierBandLineThickness\":2,\"outlierBandMarkerSize\":10,\"outlierBandMarkerType\":\"triangle\",\"markerSize\":0,\"lineDashType\":\"solid\",\"markerType\":\"none\",\"lineThickness\":2,\"mode\":\"timeSeries\"},\"axes\":{\"axisX\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":10},\"axisY\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":12,\"logarithmic\":false,\"gridColor\":\"#dde4e9\"}},\"legend\":{\"enabled\":true,\"verticalAlign\":\"bottom\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":false,\"wrap\":true},\"color\":{\"family\":\"scheme5\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/Workday* \n| json \"System_Account\", \"Session_IP_Address\", \"Request_Originator\",\"Failed_Signon\", \"tenant_name\"  nodrop\n| where !(System_Account matches \"wd-*\") and Session_IP_Address matches \"{{IPAddress}}\" and tenant_name matches \"{{TenantName}}\" and System_Account matches \"{{SystemUser}}\"\n| timeslice 1h\n| count by _timeslice\n| outlier _count window=6, threshold=2\n| where _count_std > 0\n| if(_count_violation=1,abs(_count_error)/_count_std, 0) as deviation\n| if(deviation >= 1, 1, 0) as total_logins_anomaly\n| fields _timeslice, total_logins_anomaly //, _count_violation, _count_error, _count_std, deviation",
          "queryType": "Logs",
          "queryKey": "B",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Manual",
          "timeSource": "Message",
          "outputCardinalityLimit": null
        },
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/Workday* \n| json \"System_Account\", \"Session_IP_Address\", \"Request_Originator\",\"Failed_Signon\", \"tenant_name\"  nodrop\n| where !(System_Account matches \"wd-*\") and Session_IP_Address matches \"{{IPAddress}}\" and tenant_name matches \"{{TenantName}}\" and System_Account matches \"{{SystemUser}}\"\n| timeslice 1h\n| where Failed_Signon=1\n| count by _timeslice\n| outlier _count window=6, threshold=2\n| where _count_std > 0\n| if(_count_violation=1,abs(_count_error)/_count_std, 0) as deviation\n| if(deviation >= 1, 1, 0) as failed_logins_anomaly\n| fields _timeslice, failed_logins_anomaly //, _count_violation, _count_error, _count_std, deviation\n",
          "queryType": "Logs",
          "queryKey": "C",
