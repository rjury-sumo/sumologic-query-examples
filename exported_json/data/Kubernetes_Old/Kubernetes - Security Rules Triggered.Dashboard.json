      "key": "panelpane-f7aa7faaba70da4a",
      "title": "Shell Configuration Modifications",
      "visualSettings": "{\"general\":{\"type\":\"svp\"},\"svp\":{\"label\":\" \",\"noDataString\":\"0\",\"thresholds\":[{\"from\":null,\"to\":null,\"color\":\"green\"},{\"from\":null,\"to\":null,\"color\":\"yellow\"},{\"from\":null,\"to\":null,\"color\":\"red\"}]}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "*falco* cluster={{cluster}} output_fields rule priority output \n | json  \"log.priority\" as priority \n| json  \"log.rule\" as rule\n| where rule=\"Modify Shell Configuration File\"\n| count",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Manual",
