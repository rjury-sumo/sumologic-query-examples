    {
      "id": null,
      "key": "panelPANE-76898759AFDEDB47",
      "title": "Memory Ballooning - Info",
      "visualSettings": "{\"general\":{\"mode\":\"TextPanel\",\"type\":\"text\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"text\":{\"format\":\"markdownV2\"},\"series\":{},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "TextPanel",
      "text": "Each VM in vSphere can have a balloon driver installed on it. This Balloon driver can inflate by gathering unused memory across various VM's and when ESXi host runs low on physical memory that it needs to allocate (< 6%), it can reclaim memory from this Balloon. \nIf your environment is healthy and virtual machines are properly rightsized, memory ballooning should generally be unnecessary.\n\nThe below Panel will get populated if the Balloon driver is installed on Vshere VM.\n"
    }
