      "visualSettings": "{\"general\":{\"mode\":\"distribution\",\"type\":\"pie\"},\"color\":{\"family\":\"scheme7\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": " _sourceCategory={{KubeSystemLogSource}}  \n| parse \"\\\"log\\\":\\\"*       *\\\"\" as log_code,log_message\n| parse field=log_message \"* *.*:*]*\" as step, resource, action, step_code, specific_message\n| fields - log_message\n| count container | top 10 container by _count",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
