    },
    {
      "id": null,
      "key": "panelpane-96454a33bf7cbb43",
      "title": "Error Messages",
      "visualSettings": "{\"general\":{\"mode\":\"distribution\",\"type\":\"pie\"},\"color\":{\"family\":\"scheme6\"},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": " _sourceCategory={{KubeSystemLogSource}}  \n| parse \"\\\"log\\\":\\\"*       *\\\"\" as log_code,log_message\n| parse field=log_message \"* *.*:*]*\" as step, resource, action, step_code, msg\n| parse field=log_code \"* *\" as severity, timestmp\n| where severity matches \"E*\"\n| count by container, severity, resource, msg \n| limit 10",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelpane-e60c4a9c92c9fb43",
      "title": "Error Stream",
      "visualSettings": "{\"general\":{\"mode\":\"distribution\",\"type\":\"table\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory={{KubeSystemLogSource}}  error\n| json field=_raw \"log\"\n| parse regex field=log \"^(?<severity>.)(?:[0-9])\"\n| where severity == \"E\"\n| formatDate(_messageTime,\"MM-dd-yyyy HH:mm\") as MessageTime\n| count by MessageTime,severity, container, namespace,pod,log",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
