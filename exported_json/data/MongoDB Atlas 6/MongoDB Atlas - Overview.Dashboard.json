      "visualSettings": "{\"title\":{\"fontSize\":14},\"axes\":{\"axisX\":{\"titleFontSize\":12,\"labelFontSize\":12},\"axisY\":{\"titleFontSize\":12,\"labelFontSize\":12}},\"series\":{},\"general\":{\"type\":\"table\",\"displayType\":\"default\",\"paginationPageSize\":100,\"fontSize\":12,\"mode\":\"distribution\"},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory=Labs/MongoDBAtlas/logs (\"dbexit\") or  ( \"] waiting for connections on port\") or (\"transition to\" or \"Transition to\") \n| json \"t.$date\",\"s\",\"c\",\"ctx\" as timestamp,severity,component,context\n| json \"msg\",\"project_id\",\"hostname\",\"cluster_name\"\n| if (_raw matches \"*dbexit*\", \"Down\",if (_raw matches \"*Transition to*\", \"Up\" ,if (_raw matches \"*] waiting for connections on port*\", \"Up\", \"UnKnown\")))  as server_status\n| timeslice 100s\n| withtime server_status \n| where (server_status = \"Up\")\n| withtime _messagetime\n| most_recent(server_status_withtime) as server_status, most_recent(_messagetime_withtime) as m_time by hostname\n| formatDate(fromMillis(m_time), \"MM-dd-yyyy HH:mm:ss:SSS\", \"etc/utc\") as event_time\n| ((toMillis(now())-m_time)/(1000*60)) as since_mins | format(\"%.2f\", since_mins) as since_minutes\n| concat (\"Since \", since_minutes, \" minutes\") as Remark\n| fields - m_time, since_mins, since_minutes \n| fields hostname, event_time, server_status, remark",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
