      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory={{S3ServerAccessLogsSource}}   \n| parse \"* * [*] * * * * * \\\"* HTTP/1.1\\\" * * * * * * * \\\"*\\\" *\" as bucket_owner, bucket, time, remoteIP, requester, request_ID, operation, key, request_URI, status_code, error_code, bytes_sent, object_size, total_time, turn_time, referrer, user_agent, version_ID\n| where (bytes_sent != \"-\")\n| where bucket matches \"{{S3_Bucket}}\"\n| ((bytes_sent/(1024))/1024) as mbytes1\n| sum(mbytes1) as data_sent by bucket\n| sort by data_sent",
          "queryType": "Logs",
