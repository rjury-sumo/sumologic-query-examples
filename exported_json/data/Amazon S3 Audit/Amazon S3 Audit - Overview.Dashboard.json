      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory={{S3ServerAccessLogsSource}}   \n| parse \"* * [*] * * * * * \\\"* HTTP/1.1\\\" * * * * * * * \\\"*\\\" *\" as bucket_owner, bucket, time, remoteIP, requester, request_ID, operation, key, request_URI, status_code, error_code, bytes_sent, object_size, total_time, turn_time, referrer, user_agent, version_ID \n| where bucket matches \"{{S3_Bucket}}\"\n| parse regex field=operation \"[A-Z]+\\.(?<operation>[\\w.]+)\" \n| count by operation",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
