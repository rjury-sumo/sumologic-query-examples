    {
      "id": null,
      "key": "panel78C0207D8E180A45",
      "title": "Processes by Disk Read/Write Operations",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"general\":{\"type\":\"honeyComb\",\"displayType\":\"default\",\"mode\":\"honeyComb\"},\"honeyComb\":{\"thresholds\":[{\"from\":0,\"to\":65,\"color\":\"#28aa55\"},{\"from\":65,\"to\":85,\"color\":\"#F2DA73\"},{\"from\":85,\"to\":null,\"color\":\"#f36644\"}],\"shape\":\"hexagon\",\"groupBy\":[{\"label\":\"host.name\",\"value\":\"host.name\"}],\"aggregationType\":\"sum\"},\"series\":{}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "sumo.datasource=windows   metric=process.disk.operations (direction=read or direction=write) AND deployment.environment={{deployment.environment}} host.group={{host.group}} host.name={{host.name}}  process.executable.name={{process.executable.name}} | sum by host.name, process.executable.name | filter sum > 65 |  topk(10, sum) ",
          "queryType": "Metrics",
          "queryKey": "A",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
