      "key": "panelPANE-274FC96BA2199B4E",
      "title": "Merge  Time",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"general\":{\"type\":\"line\",\"displayType\":\"default\",\"markerSize\":5,\"lineDashType\":\"solid\",\"markerType\":\"none\",\"lineThickness\":1,\"mode\":\"timeSeries\"},\"axes\":{\"axisX\":{\"title\":\" \",\"titleFontSize\":12,\"labelFontSize\":12},\"axisY\":{\"title\":\" \",\"titleFontSize\":12,\"labelFontSize\":12,\"logarithmic\":false,\"unit\":{\"value\":\"ms\",\"isCustom\":false}},\"axisY2\":{\"unit\":{\"value\":\"ms\",\"isCustom\":false},\"logarithmic\":false}},\"legend\":{\"enabled\":false,\"verticalAlign\":\"bottom\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":false,\"wrap\":true},\"color\":{\"family\":\"Categorical Light\"},\"overrides\":[{\"series\":[],\"queries\":[\"A\"],\"properties\":{\"name\":\"db.cluster.name={{db.cluster.name}} db.node.name={{db.node.name}}\"}}],\"series\":{}}",
