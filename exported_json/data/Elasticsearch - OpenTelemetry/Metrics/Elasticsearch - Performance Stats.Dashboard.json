      "queries": [
        {
          "transient": false,
          "queryString": "sumo.datasource=elasticsearch  deployment.environment={{deployment.environment}} metric=elasticsearch.index.operations.time aggregation=total operation=merge db.cluster.name={{db.cluster.name}} db.node.name={{db.node.name}} | sum by db.cluster.name, db.node.name ",
          "queryType": "Metrics",
          "queryKey": "A",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "A shard in Elasticsearch is a Lucene index, and a Lucene index is broken down into segments. Segments are internal storage elements in the index where the index data is stored, and are immutable. Smaller segments are periodically merged into larger segments to keep the index size at bay and to expunge deletes.",
