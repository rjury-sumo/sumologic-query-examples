      "key": "panelPANE-5E2B935281E9B84E",
      "title": "System Operations",
      "visualSettings": "{\"title\":{\"fontSize\":16},\"general\":{\"type\":\"column\",\"displayType\":\"stacked\",\"outlierBandColor\":\"#FDECF5\",\"outlierBandMarkerColor\":\"#F032A9\",\"outlierBandFillOpacity\":0.5,\"outlierBandLineThickness\":2,\"outlierBandMarkerSize\":10,\"outlierBandMarkerType\":\"triangle\",\"outlierBandLineDashType\":\"solid\",\"outlierBandDisplayType\":\"default\",\"fillOpacity\":1,\"mode\":\"distribution\"},\"axes\":{\"axisX\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":10},\"axisY\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":12,\"logarithmic\":false,\"gridColor\":\"#dde4e9\"}},\"legend\":{\"enabled\":true,\"verticalAlign\":\"bottom\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":false,\"wrap\":true},\"color\":{\"family\":\"scheme9\"},\"series\":{},\"overrides\":[]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory={{Logsdatasource}}   (4608 or 4946 or 4947 or 4948 or 4949 or 4950 or 4954 or 5025 or 4727 or 4731 or 4754 or 4720)\n| json \"EventID\", \"Computer\" as event_id, host nodrop\n| \"\" as operation \n| if (event_id = \"4608\", \"Restarts\", operation) as operation  \n| if (event_id in (\"4946\", \"4947\", \"4948\", \"4949\", \"4950\", \"4954\", \"5025\"), \"Firewall Changes\", operation) as operation \n| if (event_id in (\"4727\", \"4731\", \"4754\"), \"Groups Created\", operation) as operation\n| if (event_id = \"4720\", \"Users Created\", operation) as operation\n| where operation != \"\" and host matches \"{{host}}\"\n| count as count by operation, host \n| transpose row host column operation",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
