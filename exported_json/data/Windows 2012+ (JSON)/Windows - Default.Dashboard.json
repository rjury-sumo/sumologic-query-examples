      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory={{Logsdatasource}}   (\"\\\"Level\\\":\\\"Warning\\\"\" or \"\\\"Level\\\":\\\"Error\\\"\")\n| json \"EventID\", \"Computer\", \"Level\" as event_id, host, level nodrop\n| where level in (\"Error\", \"Warning\") and host matches \"{{host}}\"\n| timeslice 1h\n| count by _timeslice, level\n| transpose row _timeslice column level\n| fillmissing timeslice(1h)",
