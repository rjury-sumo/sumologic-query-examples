{
  "type": "DashboardV2SyncDefinition",
  "name": "Nginx - Outlier Analysis",
  "description": "The Nginx -  Outlier Analysis Dashboard provides a high-level view of Nginx server outlier metrics for bytes served, number of visitors, and server errors. You can select the time interval over which outliers are aggregated, then hover the cursor over the graph to display detailed information for that point in time. Use the dashboard and panel filters to drill down and view more granular data.",
  "title": "Nginx - Outlier Analysis",
  "theme": "Light",
  "topologyLabelMap": {
    "data": {}
  },
  "refreshInterval": 0,
  "timeRange": {
    "type": "BeginBoundedTimeRange",
    "from": {
      "type": "RelativeTimeRangeBoundary",
      "relativeTime": "-1d"
    },
    "to": null
  },
