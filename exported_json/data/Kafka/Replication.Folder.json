          "title": "In-Sync Replicas (ISR) Expand Rate - One  Minute Rate",
          "visualSettings": "{\"general\":{\"mode\":\"timeSeries\",\"type\":\"line\",\"displayType\":\"default\",\"markerSize\":5,\"lineDashType\":\"solid\",\"markerType\":\"none\",\"lineThickness\":1},\"title\":{\"fontSize\":14},\"axes\":{\"axisX\":{\"title\":\"\",\"titleFontSize\":12,\"labelFontSize\":12},\"axisY\":{\"title\":\"ISR Expand Rate\",\"titleFontSize\":12,\"labelFontSize\":12,\"logarithmic\":false}},\"legend\":{\"enabled\":false,\"verticalAlign\":\"bottom\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":false,\"wrap\":true},\"color\":{\"family\":\"Categorical Default\"},\"series\":{},\"overrides\":[{\"series\":[],\"queries\":[\"A\"],\"properties\":{\"name\":\"messaging_cluster={{messaging_cluster}} Server={{Server}}\"}}]}",
          "keepVisualSettingsConsistentWithParent": true,
          "panelType": "SumoSearchPanel",
          "queries": [
            {
              "transient": false,
              "queryString": "_sourceCategory = Labs/Kafka* messaging_cluster={{messaging_cluster}} (metric=kafka_replica_manager_IsrExpandsPerSec_OneMinuteRate or metric=kafka.replica_manager_IsrExpandsPerSec.OneMinuteRate) jolokia_agent_url={{Server}}  | parse field=jolokia_agent_url * as Server",
              "queryType": "Metrics",
              "queryKey": "A",
              "metricsQueryMode": "Advanced",
              "metricsQueryData": null,
              "tracesQueryData": null,
              "spansQueryData": null,
              "parseMode": "Manual",
              "timeSource": "Message",
              "outputCardinalityLimit": 1000
            }
          ],
          "description": "The ISR Expand Rate metric displays the one minute rate of increases in the number of In-Sync Replicas (ISR). ISR expansions occur when a broker comes online, such as when recovering from a failure or adding a new node. This increases the number of in-sync replicas available for each partition on that broker.\n\nExpected value: 0",
          "timeRange": null,
          "coloringRules": null,
          "linkedDashboards": []
        },
        {
          "id": null,
