      "title": "Logins by Authentication Method",
      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\",\"type\":\"column\",\"displayType\":\"stacked\"},\"series\":{},\"legend\":{\"enabled\":false,\"verticalAlign\":\"bottom\",\"showAsTable\":false},\"color\":{\"family\":\"Categorical Light\"},\"overrides\":[]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": " db.cluster.name={{db.cluster.name}} deployment.environment={{deployment.environment}} sumo.datasource=sqlserver Logon succeeded | json \"log\" as _rawlog nodrop \n| if (isEmpty(_rawlog), _raw, _rawlog) as _raw \n| parse \"Logon       Login * for user '*'. Connection made using *. [CLIENT: *]\" as logon_status, userName, authentication_method, client_ip \n| where logon_status = \"succeeded\"\n| timeslice 1h\n| count by _timeslice, authentication_method\n| transpose row _timeslice column authentication_method",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
