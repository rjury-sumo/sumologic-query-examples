      "queries": [
        {
          "transient": false,
          "queryString": "\t_sourceCategory = *eks* \n\t| json field=_raw \"message\" as log\n\t| parse regex field=log \"^(?<severity>.)(?:[0-9])\"\n\t| timeslice 1h\n\t| count _timeslice, severity \n\t| transpose row _timeslice column severity\n  | fillmissing timeslice(1h) ",
