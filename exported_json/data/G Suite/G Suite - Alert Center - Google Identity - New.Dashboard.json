      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/gsuite/alerts email AccountWarning\n| json \"alertId\",\"customerId\",\"source\",\"type\",\"data\" as alert_id, customer_id, source, type, data\n| where source matches \"{{source}}\" and type matches \"{{type}}\"\n| json field=data \"email\",\"loginDetails.ipAddress\" as user, src_ip\n| lookup latitude, longitude, city,country_name, region\n  from geo://location on ip=src_ip \n| where country_name matches \"{{country}}\"\n|where if (\"{{customer_id}}\" = \"*\", true, customer_id matches \"{{customer_id}}\") AND if (\"{{alert_id}}\" = \"*\", true, alert_id matches \"{{alert_id}}\")\n|count by latitude,longitude, city, country_name, region",
