  "panels": [
    {
      "id": null,
      "key": "panel2EB8AC339A0D6840",
      "title": "Time Based Metrics",
      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\",\"type\":\"table\",\"decimals\":2},\"series\":{}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_index=sec_signal \n| timeslice 1d\n| toLong(createdTimestamp) as created_timestamp\n| min(created_timestamp) as first_seen, max(created_timestamp) as last_seen, count_distinct(_timeslice) as distinct_days_seen by ruleName\n| now() - last_seen as days_since_last_signal\n| days_since_last_signal/1000/60/60/24 as days_since_last_signal\n| formatDate(toLong(first_seen), \"yyyy-MM-dd\") as first_seen\n| formatDate(toLong(last_seen), \"yyyy-MM-dd\") as last_seen\n| order by days_since_last_signal",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-6A39FACA86B66B40",
      "title": "Signal Disappearances by Vendor, Product, and Event ID - 7 Days Time Comparison",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"axes\":{\"axisX\":{\"titleFontSize\":12,\"labelFontSize\":12},\"axisY\":{\"titleFontSize\":12,\"labelFontSize\":12}},\"series\":{},\"general\":{\"type\":\"table\",\"displayType\":\"default\",\"paginationPageSize\":100,\"fontSize\":12,\"mode\":\"distribution\"},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_index=sec_signal \n| json field=fullRecords \"[0].metadata_vendor\" as vendor nodrop\n| json field=fullRecords \"[0].metadata_product\" as product nodrop\n| json field=fullRecords \"[0].metadata_deviceEventId\" as deviceEventId\n| count vendor, product, deviceEventId\n| compare with timeshift 7d 4\n| order by _count",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
