    {
      "id": null,
      "key": "panelPANE-276AFCCC9BF25A42",
      "title": "Rule Severities - Current v. Recommended, sorted by Tunability",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"axes\":{\"axisX\":{\"titleFontSize\":12,\"labelFontSize\":12},\"axisY\":{\"titleFontSize\":12,\"labelFontSize\":12}},\"series\":{},\"general\":{\"type\":\"table\",\"displayType\":\"default\",\"paginationPageSize\":5,\"fontSize\":12,\"mode\":\"distribution\"},\"legend\":{\"enabled\":false},\"thresholdsSettings\":{\"type\":\"number\",\"fillRemainingGreen\":false,\"showThresholds\":false,\"numberThresholds\":{\"warning\":{\"display\":true,\"comparator\":\"includes\",\"value\":1,\"toValue\":4},\"critical\":{\"display\":true,\"comparator\":\"includes\",\"value\":4,\"toValue\":10}},\"column\":\"A:delta\",\"highlightViolations\":false,\"textThresholds\":{\"warning\":{\"display\":true,\"values\":[]},\"critical\":{\"display\":true,\"values\":[]}}}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "// id=@rule_severities_recommendations:cse_rules:\n_index=sec_record*\n| count \n| infer _model=severityrecommender _category=cse type=rule_severities minimize=\"{{minimize}}\" \n| \"{{show_rules}}\" as variable_rules | \"{{deployment}}\" as variable_deployment | \"{{domain}}\" as domain | if(variable_rules = \"Rules with severity recommendations\", 0, -1) as delta_reference | if (variable_deployment = \"prod\", \".\", concat(\".\", variable_deployment, \".\")) as sumo_deployment | int(tunability_factor) as tunability | (current_severity - recommended_severity) as delta | abs(delta) as delta | int(delta) as delta\n| where delta > delta_reference\n| parse field=rule \"[*] *\" as rule_id, rule_name\n| concat(\"_index=sumologic_audit_events  _sourceCategory=cseInsight insightupdated \\\"\", rule_id, \"\\\" \\n| \\\"\", rule, \"\\\" as rule \\n| \\\"\", tunability ,\"\\\" as tunability \\n| \\\"\",optimized_count,\"\\\" as eligible_count \\n| %\\\"insight.entityid\\\" as entity_id \\n| %\\\"insight.entitytype\\\" as entity_type \\n| %\\\"insight.resolution\\\" as resolution \\n| where !isNull(resolution) \\n| where resolution in (\\\"False Positive\\\", \\\"No Action\\\") \\n| count by rule, tunability, eligible_count, entity_id, entity_type, resolution \\n| _count as insights_created\") as _query\n| urlencode(_query) as encode_query\n| concat(\"https://\", domain, sumo_deployment, \"sumologic.com/ui/#/search/@%s,%s@%s\") as _url\n| format(_url,start_date,end_date,encode_query) as request_url\n| fields - delta_reference, variable_rules | sort by tunability desc\n| tourl(request_url, toString(tunability)) as tunability\n| fields rule, current_severity, recommended_severity, signal_count, tunability, eligible_count, optimized_count",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
