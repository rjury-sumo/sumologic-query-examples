    {
      "id": null,
      "key": "panelPANE-7C061DCEA579884F",
      "title": "Untitled",
      "visualSettings": "{\"general\":{\"mode\":\"TextPanel\",\"type\":\"text\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"series\":{},\"text\":{\"format\":\"markdownV2\",\"showTitle\":false},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "TextPanel",
      "text": "Admin Audit logs show changes made by your administrative team in your organization's Umbrella settings.\n\n###Order of Fields in Audit Log Record :\n\n        #id, timestamp, email, user, type, action, logged in from, before, after\n\n### For more info on logs, please visit https://docs.umbrella.com/deployment-umbrella/docs/log-formats-and-versioning#section-admin-audit-logs\n\n\n"
    },
    {
      "id": null,
      "key": "panelPANE-63D970DE88D2584B",
      "title": "Geo Locations of Admin Activities",
      "visualSettings": "{\"general\":{\"mode\":\"map\",\"type\":\"map\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"series\":{},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory=Labs/cisco_umbrella\n| where _sourcename matches \"*auditlogs*\" \n| parse \"\\\"*\\\",\\\"*\\\",\\\"*\\\",\\\"*\\\",\\\"*\\\",\\\"*\\\",\\\"*\\\",\\\"*\\\",\\\"*\\\"\" as  id, timestamp, email, user, type, action, ip, before, after\n| where action matches \"{{action}}\"\n| count by ip\n| lookup latitude, longitude, country_code, country_name, region, city, postal_code from geo://location on ip = ip\n| where !isNull(latitude)\n| sum(_count) as _count by latitude, longitude, country_code, country_name, region, city, postal_code\n| sort by _count",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
