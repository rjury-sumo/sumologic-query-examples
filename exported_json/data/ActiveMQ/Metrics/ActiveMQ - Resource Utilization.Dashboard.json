      "visualSettings": "{\"general\":{\"mode\":\"honeyComb\",\"type\":\"honeyComb\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"honeyComb\":{\"thresholds\":[{\"from\":0,\"to\":70,\"color\":\"#28aa55\"},{\"from\":70,\"to\":80,\"color\":\"#b4950c\"},{\"from\":80,\"to\":100,\"color\":\"#df3d3d\"}],\"shape\":\"hexagon\",\"groupBy\":[{\"label\":\"messaging_cluster\",\"value\":\"messaging_cluster\"}],\"aggregationType\":\"avg\"},\"series\":{},\"overrides\":[{\"series\":[],\"queries\":[\"A\"],\"properties\":{\"name\":\"% messaging_cluster={{messaging_cluster}} host={{host}}\"}}],\"legend\":{\"enabled\":false}}",
