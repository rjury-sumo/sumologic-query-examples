{
  "type": "DashboardV2SyncDefinition",
  "name": "Active Directory Service Failures",
  "description": "The Active Directory Service Failures dashboard provides at-a-glance view of success, failures, and audit failures overtime.",
  "title": "Active Directory Service Failures",
  "theme": "Light",
  "topologyLabelMap": {
    "data": {}
  },
  "refreshInterval": 0,
  "timeRange": {
    "type": "BeginBoundedTimeRange",
    "from": {
      "type": "RelativeTimeRangeBoundary",
      "relativeTime": "-1d"
    },
    "to": null
  },
  "layout": {
    "layoutType": "Grid",
    "layoutStructures": [
      {
        "key": "panelPANE-376F511D9014D943",
        "structure": "{\"height\":7,\"width\":12,\"x\":0,\"y\":0}"
