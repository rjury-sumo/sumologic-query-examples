        "variableSourceType": "LogQueryVariableSourceDefinition",
        "query": "_sourceCategory={{_sourceCategory}}  | json \"Computer\" as host",
        "field": "host"
      },
      "allowMultiSelect": false,
      "includeAllOption": true,
      "hideFromUI": false,
      "valueType": "Any"
