          "transient": false,
          "queryString": "_index=sumologic_volume datapoints\n| where _sourceCategory=\"collector_metrics_volume\"\n| parse regex \"\\\"(?<collector>[^\\\"]+)\\\"\\:\\{\\\"dataPoints\\\"\\:(?<datapoints>\\d+)\\}\" multi\n| timeslice 1h\n| sum(datapoints) as datapoints by _timeslice\n| sort by _timeslice asc \n| smooth datapoints as moving_avg | datapoints as curr_hrs_datapoints\n| 70 as spikePercent\n| where curr_hrs_datapoints >= (1 + spikePercent / 100) * moving_avg\n| fields -spikePercent",
