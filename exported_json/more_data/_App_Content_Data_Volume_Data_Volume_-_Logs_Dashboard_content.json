      "id": null,
      "key": "panelPANE-1",
      "title": "Ingest Spike (Last data point)",
      "visualSettings": "{\"title\":{\"fontSize\":16},\"axes\":{},\"legend\":{},\"hiddenQueryKeys\":[],\"overrides\":[],\"series\":{},\"general\":{\"type\":\"line\",\"displayType\":\"default\",\"markerSize\":5,\"lineDashType\":\"solid\",\"markerType\":\"none\",\"lineThickness\":1,\"mode\":\"timeSeries\"},\"color\":{\"family\":\"Categorical Default\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_index=sumologic_volume _sourceCategory = \"collector_and_tier_volume\"\n| parse regex \"(?<data>\\{[^\\{]+\\})\" multi\n| json field=data \"field\",\"dataTier\",\"sizeInBytes\",\"count\" as collector, dataTier, bytes, count\n|where dataTier matches \"{{Tier}}\"\n| bytes/1Mi as mbytes\n| timeslice 1h\n| sum(mbytes) as curr_hrs_mbytes by _timeslice\n| sort by _timeslice asc \n| diff curr_hrs_mbytes\n| where !isNull(_diff)\n| (_diff+curr_hrs_mbytes) as prev_hrs_mbytes\n| ((_diff / curr_hrs_mbytes) * 100) as pct_incr\n| 50 as spikePercent\n| where (-1 * pct_incr) > spikePercent\n| abs(pct_incr) as pct_incr\n| fields _timeslice, curr_hrs_mbytes, prev_hrs_mbytes, pct_incr",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
