      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "sumo.datasource=windows deployment.environment={{deployment.environment}} host.group={{host.group}} host.name={{host.name}} \n| json \"eventid\", \"channel\" as event_id, channel nodrop\n| where !isEmpty(channel) \n| timeslice 1h \n| count by _timeslice, channel\n| transpose row _timeslice column channel\n| fillmissing timeslice(1h)",
          "queryType": "Logs",
          "queryKey": "A",
