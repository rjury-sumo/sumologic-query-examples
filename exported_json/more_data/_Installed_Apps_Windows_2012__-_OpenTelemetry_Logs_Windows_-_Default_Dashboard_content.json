    {
      "id": null,
      "key": "panelPANE-CAD32BBBA6C3794D",
      "title": "Top 10 Service Operations",
      "visualSettings": "{\"title\":{\"fontSize\":16},\"general\":{\"type\":\"bar\",\"displayType\":\"stacked\",\"outlierBandColor\":\"#FDECF5\",\"outlierBandMarkerColor\":\"#F032A9\",\"outlierBandFillOpacity\":0.5,\"outlierBandLineThickness\":2,\"outlierBandMarkerSize\":10,\"outlierBandMarkerType\":\"triangle\",\"outlierBandLineDashType\":\"solid\",\"outlierBandDisplayType\":\"default\",\"fillOpacity\":1,\"mode\":\"distribution\"},\"axes\":{\"axisX\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":10},\"axisY\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":12,\"logarithmic\":false,\"gridColor\":\"#dde4e9\"}},\"legend\":{\"enabled\":true,\"verticalAlign\":\"bottom\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":false,\"wrap\":true},\"color\":{\"family\":\"scheme9\"},\"series\":{},\"overrides\":[]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "sumo.datasource=windows deployment.environment={{deployment.environment}} host.group={{host.group}} host.name={{host.name}}  \"\\\"channel\\\":\\\"System\\\"\" (running or stopped) \n| json \"event_id\", \"message\", \"event_data\", \"channel\", \"provider\" as event_id_obj, msg_summary, event_data, channel, event_source_name nodrop \n| json field=event_id_obj \"id\" as event_id\n| parse field=event_data \"*\\n*\" as service_name,service_state\n| where event_id = \"7036\" and service_state in (\"running\", \"stopped\") and channel = \"System\" \n| if (service_state = \"running\", 1, 0) as starts\n| if (service_state = \"stopped\", 1, 0) as stops \n| sum(starts) as starts, sum(stops) as stops by service_name, host.name\n| sort by stops, starts\n| limit 10\n| fields -host.name",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
