    {
      "id": null,
      "key": "panelpane-f11159ccb268494f",
      "title": "Events by Cluster Over Time",
      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\"},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/gcp/kubernetes* logName resource\n| parse regex \"\\\"logName\\\":\\\"(?<log_name>[^\\\"]+)\\\"\"\n| where log_name matches \"projects/*/logs/events\"\n| json \"message.data.resource.labels\" as labels\n| json field=labels \"project_id\", \"cluster_name\" as project, cluster\n| timeslice 1h\n| count as events by _timeslice, cluster, project\n| transpose row _timeslice column cluster, project",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Manual",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelpane-03e557e8abdf7944",
      "title": "Events and Errors Over Time",
      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\"},\"legend\":{\"verticalAlign\":\"bottom\",\"enabled\":true}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/gcp/kubernetes* logName resource severity \"\\\"kind\\\":\\\"Event\\\"\"\n| parse regex \"\\\"logName\\\":\\\"(?<log_name>[^\\\"]+)\\\"\"\n| json \"message.data.resource.labels\", \"message.data.severity\" as labels, severity\n| json field=labels \"project_id\", \"cluster_name\" as project, cluster\n| if (severity in (\"WARNING\", \"ALERT\", \"CRITICAL\", \"FATAL\", \"EMERGENCY\"), 1, 0) as error\n| timeslice 1h\n| count as events, sum(error) as errors by _timeslice\n| compare with timeshift 1d 7 avg\n| fillmissing timeslice(1h) ",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Manual",
          "timeSource": "Message",
