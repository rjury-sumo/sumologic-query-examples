      "title": "Nodes % Resource Usage",
      "visualSettings": "{\"general\":{\"type\":\"honeyComb\"},\"honeyComb\":{\"groupBy\":[{\"label\":\"cluster\",\"value\":\"cluster\"},{\"label\":\"metric\",\"value\":\"metric\"}],\"thresholds\":[{\"from\":0,\"to\":75,\"color\":\"#69DB4A\"},{\"from\":75,\"to\":85,\"color\":\"#E1C60E\"},{\"from\":85,\"to\":101,\"color\":\"#C73A25\"}],\"aggregationType\":\"avg\"},\"series\":{}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "metric=node:node_memory_utilisation:ratio cluster={{cluster}}  | max by cluster,node, metric |  topk(500,max) | eval _value *100 | eval round(_value)",
