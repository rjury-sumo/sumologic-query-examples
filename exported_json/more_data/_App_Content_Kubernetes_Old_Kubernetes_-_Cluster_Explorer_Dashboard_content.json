          "queryString": "metric=node:node_cpu_utilisation:avg1m cluster={{cluster}}  | max by cluster,node, metric | topk(500,max) | eval _value *100 | eval round(_value)",
          "queryType": "Metrics",
          "queryKey": "B",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
