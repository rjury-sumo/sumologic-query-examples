          "queryString": "_sourceCategory = Labs/Windows/OS/Windows  Security (4608 or 4946 or 4947 or 4948 or 4727 or 4731 or 4754 or 4720)\n| parse \"EventCode = *;\" as event_id\n| parse \"Computer = \\\"*\\\";\" as host nodrop | parse \"ComputerName = \\\"*\\\";\" as host nodrop\n| \"\" as operation\n| if(event_id=\"4608\",\"Restarts\",operation) as operation  \n| if(event_id in (\"4946\", \"4947\", \"4948\"),\"Firewall Changes\",operation) as operation \n| if(event_id in (\"4727\", \"4731\", \"4754\"),\"Groups Created\",operation) as operation\n| if(event_id=\"4720\",\"Users Created\",operation) as operation\n| where operation != \"\"\n|where if (\"{{event_id}}\" = \"*\", true, event_id matches \"{{event_id}}\")\n|count as count by operation, host \n| transpose row host column operation",
