      "key": "panelaf50bb31b81bdb44",
      "title": "Threat Sources and Targets by  Geography",
      "visualSettings": "{\"general\":{\"mode\":\"map\",\"type\":\"map\"},\"map\":{\"mainMetric\":{}}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "benchmarkcat guardduty_geo\n|where if (\"{{resource}}\" = \"*\", true, resource matches \"{{resource}}\") AND if (\"{{threatpurpose}}\" = \"*\", true, threatpurpose matches \"{{threatpurpose}}\") AND if (\"{{threatname}}\" = \"*\", true, threatname matches \"{{threatname}}\") AND if (\"{{severity}}\" = \"> -2147483648\", true, severity {{severity}})\n|sum(percentage) as percentage by threatpurpose, threatname, sourcelat, sourcelon, destinationlat, destinationlon\n| topk(3, percentage) group by threatpurpose",
          "queryType": "Logs",
          "queryKey": "A",
