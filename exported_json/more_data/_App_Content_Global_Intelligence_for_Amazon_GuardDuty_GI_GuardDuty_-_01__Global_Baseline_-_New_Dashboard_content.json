    {
      "id": null,
      "key": "panel13138ee886bc8948",
      "title": "Overview",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"general\":{\"type\":\"text\",\"displayType\":\"default\",\"mode\":\"TextPanel\"},\"legend\":{\"enabled\":false},\"text\":{\"format\":\"markdownV2\",\"fontSize\":14},\"series\":{}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "TextPanel",
      "text": "###The global baseline is a collection of stats averaged over Amazon GuardDuty findings for all Sumo Logic customers over the prior 7 days. **Threat Mix: ALL Threats** depicts share of total findings by Threat Name across Sumo Logic customers over the prior 7 days. Rare threats account for less that 0.2% of findings on average over the past 7 days. **Threat Mix: Rare Threats** depict shares of total findings by Rare Threat Name across Sumo Logic customers.###"
    },
    {
      "id": null,
      "key": "paneld1b516e68da56942",
      "title": "Threat Percent: ALL Threats",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"general\":{\"type\":\"bar\",\"displayType\":\"stackedPercent\",\"fillOpacity\":1,\"mode\":\"timeSeries\"},\"axes\":{\"axisX\":{\"hideLabels\":false,\"title\":\"\",\"titleFontSize\":1,\"labelFontSize\":15},\"axisY\":{\"hideLabels\":false,\"title\":\"\",\"titleFontSize\":1,\"labelFontSize\":15,\"logarithmic\":false,\"gridColor\":\"\",\"minimum\":0,\"maximum\":null}},\"legend\":{\"enabled\":true,\"verticalAlign\":\"right\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":true,\"wrap\":true},\"color\":{\"family\":\"Categorical Default\"},\"thresholdsSettings\":{\"fillRemainingGreen\":false,\"showThresholds\":false,\"numberThresholds\":{\"warning\":{\"display\":true,\"comparator\":\"greater_or_equal\",\"value\":80},\"critical\":{\"display\":true,\"comparator\":\"greater_or_equal\",\"value\":100}},\"highlightViolations\":true}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
