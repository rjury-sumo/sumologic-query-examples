          "transient": false,
          "queryString": "_sourceCategory = Labs/VMWare6.5 and (\"error\" or \"fail\" or \"critical\")\n | parse \"eventType=*,,,\" as event_type\n | parse \"host=*,,,\" as esx_host \n | parse \"vm=*,,,\" as vm \n | parse \"computeResource=*,,,\" as cluster nodrop\n | where esx_host matches \"{{esx_host}}\" and vm matches \"{{vm}}\"\n | count_frequent vm\n | limit 10\n\n",
