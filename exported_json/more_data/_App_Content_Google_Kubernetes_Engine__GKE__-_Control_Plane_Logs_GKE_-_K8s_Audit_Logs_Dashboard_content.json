      "title": "RBAC Modifications",
      "visualSettings": "{\"general\":{\"type\":\"svp\"},\"title\":{\"fontSize\":\"RBAC Modifications\"},\"svp\":{\"label\":\" \",\"noDataString\":\"0\",\"thresholds\":[{\"from\":-1,\"to\":0,\"color\":\"green\"},{\"from\":1,\"to\":10,\"color\":\"yellow\"},{\"from\":10,\"to\":null,\"color\":\"red\"}]}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/gcp/kubernetes* \n| json \"message.data.resource.type\" as type \n| parse regex \"\\\"logName\\\":\\\"(?<log_name>[^\\\"]+)\\\"\" \n| parse regex \"\\\"methodName\\\":\\\"(?<methodName>[^\\\"]+)\\\"\" \n| parse regex \"\\\"principalEmail\\\":\\\"(?<principalEmail>[^\\\"]+)\\\"\" \n| where log_name matches \"*activity*\" and type=\"k8s_cluster\" and !(principalEmail matches \"*system*\") and (methodName matches \"*io.k8s.authorization.rbac.v1*\")\n| count ",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Manual",
          "timeSource": "Message",
