  "panels": [
    {
      "id": null,
      "key": "panelPANE-376F511D9014D943",
      "title": "Successes vs Failures",
      "visualSettings": "{\"title\":{\"fontSize\":16},\"general\":{\"type\":\"column\",\"displayType\":\"stacked\",\"outlierBandColor\":\"#FDECF5\",\"outlierBandMarkerColor\":\"#F032A9\",\"outlierBandFillOpacity\":0.5,\"outlierBandLineThickness\":2,\"outlierBandMarkerSize\":10,\"outlierBandMarkerType\":\"triangle\",\"outlierBandLineDashType\":\"solid\",\"outlierBandDisplayType\":\"default\",\"fillOpacity\":1,\"mode\":\"timeSeries\"},\"axes\":{\"axisX\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":10},\"axisY\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":12,\"logarithmic\":false,\"gridColor\":\"#dde4e9\"}},\"legend\":{\"enabled\":true,\"verticalAlign\":\"bottom\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":false,\"wrap\":true},\"color\":{\"family\":\"scheme9\"},\"series\":{},\"overrides\":[]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "sumo.datasource=activeDirectory  keywords\n| json \"event_id\", \"computer\", \"keywords\" as event_id, host.name, keywords nodrop\n| if (keywords = \"Audit Failure\", \"Failure\", \"Success\") as status\n| where host.name matches \"{{host.name}}\"\n| timeslice 1h\n| count as EventCount by  status, _timeslice\n| transpose row _timeslice column status",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panelPANE-7A2E3ED49E8B5A4B",
      "title": "Audit Failures Over Time",
      "visualSettings": "{\"title\":{\"fontSize\":16},\"general\":{\"type\":\"column\",\"displayType\":\"stacked\",\"outlierBandColor\":\"#FDECF5\",\"outlierBandMarkerColor\":\"#F032A9\",\"outlierBandFillOpacity\":0.5,\"outlierBandLineThickness\":2,\"outlierBandMarkerSize\":10,\"outlierBandMarkerType\":\"triangle\",\"outlierBandLineDashType\":\"solid\",\"outlierBandDisplayType\":\"default\",\"fillOpacity\":1,\"mode\":\"timeSeries\"},\"axes\":{\"axisX\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":10},\"axisY\":{\"title\":\"\",\"titleFontSize\":11,\"labelFontSize\":12,\"logarithmic\":false,\"gridColor\":\"#dde4e9\"}},\"legend\":{\"enabled\":true,\"verticalAlign\":\"bottom\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":false,\"wrap\":true},\"color\":{\"family\":\"scheme9\"},\"series\":{},\"overrides\":[]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "sumo.datasource=activeDirectory  \"\\\"keywords\\\":\\\"Audit Failure\\\"\"\n| json \"event_id\", \"computer\", \"keywords\" as event_id, host.name, keywords nodrop\n| json field=event_id \"id\" as event_id\n| where keywords = \"Audit Failure\" and host.name matches \"*\"\n| timeslice 1h\n| count as failures by _timeslice, event_id\n| transpose row _timeslice column event_id",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    }
  ],
  "variables": [
    {
      "id": null,
      "name": "host.name",
      "displayName": "host.name",
      "defaultValue": "*",
      "sourceDefinition": {
        "variableSourceType": "LogQueryVariableSourceDefinition",
        "query": "sumo.datasource=activeDirectory  | json \"computer\" as host.name",
        "field": "host.name"
      },
      "allowMultiSelect": false,
      "includeAllOption": true,
      "hideFromUI": false,
      "valueType": "Any"
    }
