    {
      "id": null,
      "key": "panelPANE-CC271298A82D6B4D",
      "title": "Job URL",
      "visualSettings": "{\"title\":{\"fontSize\":16},\"general\":{\"type\":\"table\",\"displayType\":\"default\",\"outlierBandColor\":\"#FDECF5\",\"outlierBandMarkerColor\":\"#ED3CPE\",\"outlierBandFillOpacity\":0.3,\"outlierBandLineThickness\":2,\"outlierBandMarkerSize\":10,\"outlierBandMarkerType\":\"triangle\",\"paginationPageSize\":100,\"fontSize\":12,\"mode\":\"distribution\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/Jenkins* Job_Status {{Name}}\n| _sourceHost as Master\n| json \"name\" as Name\n| where Name matches \"{{Name}}\" \n| first(_raw) as message by Name, Master\n| parse regex field=message \"\\\"(?<Key>.*?)\\\":(?<Value>.*?),\"  multi\n| where key in (\"jobBuildURL\", \"upstreamJobURL\", \"hudsonVersion\")\n| json field=message \"jobBuildURL\", \"number\" as URL, number\n| replace(URL, concat(\"/\",number,\"/\"), \"\") as URL\n| concat(URL, \"/configure\") as Config_URL\n| if(key=\"hudsonVersion\" , Config_URL, Value) as Value\n| replace(Value, \"\\\"\", \"\") as Value\n| parse field=URL \"*://*/\" as domain, url_base nodrop\n| if(key=\"upstreamJobURL\" , if(isEmpty(value), \"\",concat(domain, \"://\",url_base,\"/\",Value)), Value) as Value\n| if(Key=\"hudsonVersion\", \"CONFIG URL\", if(Key=\"jobBuildURL\", \"BUILD URL\", \"UPSTREAM JOB URL\")) as Key\n| if(isEmpty(value) ,\"-\", tourl(Value, Key)) as URL\n| where URL != \"-\"\n| fields Master, URL",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": null
        }
      ],
