      "title": "Number of Topics",
      "visualSettings": "{\"general\":{\"mode\":\"singleValueMetrics\",\"type\":\"svp\",\"displayType\":\"default\"},\"overrides\":[],\"title\":{\"fontSize\":14},\"svp\":{\"option\":\"Maximum\",\"label\":\"Topic(s)\",\"useBackgroundColor\":false,\"useNoData\":false,\"noDataString\":\"\",\"hideData\":false,\"hideLabel\":false,\"rounding\":2,\"valueFontSize\":24,\"labelFontSize\":14,\"thresholds\":[{\"from\":null,\"to\":null,\"color\":\"#16943E\"},{\"from\":null,\"to\":null,\"color\":\"#DFBE2E\"},{\"from\":null,\"to\":null,\"color\":\"#BF2121\"}],\"sparkline\":{\"show\":true,\"color\":\"#222D3B\"},\"gauge\":{\"show\":false}},\"series\":{}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/Kafka* messaging_cluster={{messaging_cluster}} (metric=kafka_topic_BytesInPerSec_Count or metric=kafka.topic_BytesInPerSec.Count) jolokia_agent_url={{Server}}  | parse field=jolokia_agent_url * as Server | count by topic | count\n ",
          "queryType": "Metrics",
          "queryKey": "A",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Manual",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "",
      "timeRange": null,
      "coloringRules": null,
      "linkedDashboards": []
    },
    {
      "id": null,
      "key": "panel8B0352D6A066A840",
      "title": "Incoming Bytes and Topics by Server",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"general\":{\"type\":\"honeyComb\",\"displayType\":\"default\",\"mode\":\"honeyComb\"},\"honeyComb\":{\"thresholds\":[{\"from\":null,\"to\":null,\"color\":\"#98ECA9\"},{\"from\":null,\"to\":null,\"color\":\"#F2DA73\"},{\"from\":null,\"to\":null,\"color\":\"#FFB5B5\"}],\"shape\":\"hexagon\",\"groupBy\":[{\"label\":\"IP\",\"value\":\"IP\"}],\"aggregationType\":\"avg\"},\"series\":{},\"overrides\":[{\"series\":[],\"queries\":[\"A\"],\"properties\":{\"name\":\"messaging_cluster={{messaging_cluster}} Server={{Server}} Topic={{topic}} MBytes IN \"}}]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/Kafka* messaging_cluster={{messaging_cluster}}  (metric=kafka_topic_BytesInPerSec_Count or metric=kafka.topic_BytesInPerSec.Count) jolokia_agent_url={{Server}}  | eval(_value /1000000)| parse field=jolokia_agent_url * as Server |parse field=Server http://*/** as IP, path ",
          "queryType": "Metrics",
          "queryKey": "A",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Manual",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
