      "title": "Client Protocols",
      "visualSettings": "{\"general\":{\"mode\":\"distribution\",\"type\":\"pie\"},\"series\":{},\"legend\":{\"enabled\":false},\"color\":{\"family\":\"Categorical Light\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "db_cluster=* db_cluster={{db_cluster}} db_system=memcached memcached \"Client using the\" | json \"log\" as _rawlog nodrop \n| if (isEmpty(_rawlog), _raw, _rawlog) as memcached_log_message\n| parse regex field=memcached_log_message \"(?<pid>\\d+): Client using the (?<protocol>\\w+) protocol\"\n| count as count by protocol\n| sort by count",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
