          "transient": false,
          "queryString": "db_cluster=* db_cluster={{db_cluster}} db_system=memcached memcached \"<\" ( TOUCH or GET or STATS or ADD or SET or REPLACE) | json \"log\" as _rawlog nodrop \n| if (isEmpty(_rawlog), _raw, _rawlog) as memcached_log_message\n| parse regex field=memcached_log_message \"<(?<pid>\\d+) (?<cmd>\\w+)*\"\n| toUpperCase(cmd) as cmd\n| where cmd matches \"TOUCH\" or cmd matches \"GET\" or cmd matches \"STATS\" or cmd matches \"ADD\" or cmd matches \"SET\" or cmd matches \"REPLACE\"\n| if(cmd matches \"TOUCH\",1,0) as TOUCH\n| if(cmd matches \"GET\",1,0) as GET\n| if(cmd matches \"STATS\",1,0) as STATS\n| if(cmd matches \"ADD\",1,0) as ADD\n| if(cmd matches \"SET\",1,0) as SET\n| if(cmd matches \"REPLACE\",1,0) as REPLACE\n| timeslice by 1h \n| sum (TOUCH) as TOUCH,  sum (GET) as GET, sum (STATS) as STATS, sum (ADD) as ADD, sum (SET) as SET, sum (REPLACE) as REPLACE by _timeslice",
