      "key": "panelDE1D9EE9995C294A",
      "title": "Request Handler Idle Percent",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"general\":{\"type\":\"honeyComb\",\"displayType\":\"default\",\"mode\":\"honeyComb\"},\"honeyComb\":{\"thresholds\":[{\"from\":0,\"to\":10,\"color\":\"#bf2121\"},{\"from\":10.000001,\"to\":20,\"color\":\"#f0731f\"},{\"from\":20.000001,\"to\":100,\"color\":\"#116b25\"}],\"shape\":\"hexagon\",\"groupBy\":[],\"aggregationType\":\"latest\"},\"series\":{},\"overrides\":[{\"series\":[],\"queries\":[\"A\"],\"properties\":{\"name\":\"messaging_cluster={{messaging_cluster}} Server={{Server}} \"}}]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/Kafka* messaging_cluster={{messaging_cluster}}  (metric=kafka_request_handlers_MeanRate or metric=kafka.request_handlers.MeanRate) jolokia_agent_url=*  | eval (_value * 100) | parse field=jolokia_agent_url * as Server",
          "queryType": "Metrics",
          "queryKey": "A",
          "metricsQueryMode": "Advanced",
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Manual",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
      "description": "The Request Handler Idle Percent metric displays the one minute rate and the mean rate of the percentage of time (expressed as a number from 0-1) that Kafka’s request handler threads are idle. Kafka’s request handler threads are responsible for servicing client requests, including reading and writing messages to disk. If the request handler threads get overloaded, the time taken for requests to complete will be longer. If the request handler idle percent is constantly below 0.2 (20%), your cluster is likely overloaded and requires a capacity increase. This can be achieved by either adding new nodes to the cluster or upgrading the individual nodes in the cluster. ",
      "timeRange": null,
      "coloringRules": null,
