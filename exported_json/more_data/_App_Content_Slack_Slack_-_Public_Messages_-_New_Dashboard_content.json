    {
      "id": null,
      "key": "panel3988cd6b8ff68843",
      "title": "Recent Attachments",
      "visualSettings": "{\"title\":{\"fontSize\":12},\"series\":{},\"general\":{\"type\":\"table\",\"fontSize\":12,\"mode\":\"timeSeries\"},\"thresholdsSettings\":{\"fillRemainingGreen\":false,\"showThresholds\":false,\"numberThresholds\":{\"warning\":{\"display\":true,\"comparator\":\"greater_or_equal\",\"value\":80},\"critical\":{\"display\":true,\"comparator\":\"greater_or_equal\",\"value\":100}},\"highlightViolations\":true}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = Labs/Slack \"logType\":\"ConversationLog\"\n| json \"userName\", \"type\", \"subtype\", \"ts\", \"text\", \"channelId\", \"channelName\", \"teamName\", \"attachments\" as User, Type, SubType, MessageTime, Text, ChannelId, Channel, Workspace, Attachments nodrop\n| where !isEmpty(Attachments)\n| parse regex field=Attachments \"(?<Attachment>\\{[^\\}]+(?:\\}\\}|\\}))\" multi\n| json field=Attachment \"id\", \"text\", \"author_name\", \"author_link\", \"pretext\", \"fallback\" as AttachmentId, AttachementText, AuthorName, AuthorLink, PreText, Fallback nodrop\n| if (isEmpty(AuthorName), \"-\", AuthorName) as AuthorName\n| where Workspace matches \"{{Workspace}}\" and Channel matches \"{{Channel}}\" and AttachementText matches \"{{AttachementText}}\" and AuthorName matches \"{{AuthorName}}\" and User matches \"{{User}}\"\n| formatDate(fromMillis(toLong(MessageTime*1000)),\"yyyy-MM-dd HH:mm:ss.SSS ZZZZ\") as Time\n| AttachementText as %\"Attachement Text\" \n| AuthorName as %\"Author Name\"\n| tourl(AuthorLink, \"Author Link\") as %\"Author Link\"\n| count as Count by Time, Workspace, Channel, User, Text, %\"Attachement Text\", Fallback, PreText, AuthorName, %\"Author Link\"\n| sort by Time\n| limit 20\n| fields - Count",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": null
