    {
      "id": null,
      "key": "panelb1eed92dbef2e94d",
      "title": "Instructions",
      "visualSettings": "{\"title\":{\"fontSize\":14},\"general\":{\"type\":\"text\",\"displayType\":\"default\",\"mode\":\"TextPanel\"},\"legend\":{\"enabled\":false},\"text\":{\"format\":\"markdownV2\",\"fontSize\":14},\"series\":{}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "TextPanel",
      "text": "Permissions required in Slack authorization token to get the logs are\n\n\n\n\n- *team:read*, *users:read*, *channels:history*, *channels:read*."
