    {
      "id": null,
      "key": "panelPANE-9",
      "title": "Notes",
      "visualSettings": "{\"title\":{\"fontSize\":16},\"general\":{\"mode\":\"TextPanel\",\"type\":\"text\",\"displayType\":\"default\",\"outlierBandColor\":\"#FDECF5\",\"outlierBandMarkerColor\":\"#F032A9\",\"outlierBandFillOpacity\":0.3,\"outlierBandLineThickness\":2,\"outlierBandMarkerSize\":10,\"outlierBandMarkerType\":\"triangle\",\"fillOpacity\":1,\"aggregationType\":\"average\",\"groupBy\":[]},\"axes\":{},\"legend\":{},\"color\":{},\"hiddenQueryKeys\":[],\"overrides\":[],\"series\":{},\"text\":{\"fontSize\":15,\"horizontalAlignment\":\"left\",\"verticalAlignment\":\"top\",\"showTitle\":true}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "TextPanel",
      "text": "- The \"Daily_Log_Ingest_Capacity\" and \"Metric_DPM_Ingest_Capacity\" values needs to be configured based on Account Subscription.\n    If you have  Credit based plan , please check with your account executive to determine these values  for your account.\n   Otherwise , see Administration > Account > Account Overview to get your Capacity Values.\n\n    Configure the \" Daily Log Ingest Capacity\"  and  \"Metric DPM Ingest Capacity\" values in the dashboard filters\n\n- Tracing is a credits-based model only and does not support the concept of ingest capacity .\n\n- Your account is probably experiencing account overages if you see \"Log Ingest Capacity Utilization\" and or \"DPM Ingest Capacity Utilization\" panel showing more than 100%.\n"
    },
    {
      "id": null,
      "key": "panelPANE-6CDB4F29999A0B46",
      "title": "Subscribed Log Ingest Capacity",
      "visualSettings": "{\"general\":{\"mode\":\"singleValueMetrics\",\"type\":\"svp\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"svp\":{\"option\":\"Average\",\"label\":\"GB/Day\",\"useBackgroundColor\":false,\"useNoData\":false,\"noDataString\":\"No data\",\"hideData\":false,\"hideLabel\":false,\"rounding\":2,\"valueFontSize\":30,\"labelFontSize\":10,\"thresholds\":[{\"from\":null,\"to\":null,\"color\":\"#007ca6\"},{\"from\":null,\"to\":null,\"color\":\"#2a84a2\"},{\"from\":null,\"to\":null,\"color\":\"#007ca6\"}],\"sparkline\":{\"show\":false},\"gauge\":{\"show\":false}},\"series\":{},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_index=sumologic_volume _sourcecategory=\"collector_and_tier_volume\"\n| parse regex \"(?<data>\\{[^\\{]+\\})\" multi\n| json field=data \"field\",\"dataTier\",\"sizeInBytes\",\"count\" as sourcecategory, dataTier, bytes, count\n| where  dataTier matches \"{{Tier}}\"\n| bytes/1Gi as gbytes \n| sum(gbytes) as ingest_gbytes\n| ((queryEndTime() - queryStartTime())/(1000*60*60*24)) as duration_in_day\n| ingest_gbytes / duration_in_day as %\"AvgLogIngestPerDay\"\n| {{Daily_Log_Ingest_Capacity}} as %\"DailyLogIngestCapacity\" // This is account contract based value. Customize this value. Can be found in Administration > Account > Account Overview\n| fields %\"DailyLogIngestCapacity\"",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
        }
      ],
