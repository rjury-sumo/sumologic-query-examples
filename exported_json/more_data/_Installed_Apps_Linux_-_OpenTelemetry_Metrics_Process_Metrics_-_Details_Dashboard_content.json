    {
      "id": null,
      "key": "panelPANE-B2AF09DCB4AD6B48",
      "title": "Major vs Minor Page Faults",
      "visualSettings": "{\"general\":{\"mode\":\"TextPanel\",\"type\":\"text\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"text\":{\"format\":\"markdownV2\",\"fontSize\":12},\"series\":{},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "TextPanel",
      "text": "* A minor page fault indicates the page is in memory but not allocated to the requesting process or not marked as present in the memory management unit.\n* A major page fault occurs because of the absence of the required page from the RAM and bringing it in costs heavy penalty in terms of CPU cycles. If it's value is high compare it with swap in/swap out activity to confirm thrashing (high paging activity)."
    },
    {
      "id": null,
      "key": "panelPANE-CD35AB6BA016DA4D",
      "title": "Resident Set vs Virtual Memory ",
      "visualSettings": "{\"general\":{\"mode\":\"TextPanel\",\"type\":\"text\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"series\":{},\"text\":{\"format\":\"markdownV2\",\"fontSize\":12,\"showTitle\":true},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "TextPanel",
      "text": "Virtual Memory Size is the memory a process has available for its execution. It includes all memory that the process can access, including memory that is swapped out, memory that is allocated, but not used, and memory from shared libraries.\n\nResident Set Size is the memory allocated to that process and is in RAM. It includes all stack and heap memory but excludes memory that is swapped out . It does include memory from shared libraries as long as the pages from those libraries are actually in memory. \n\nUse the RSS Memory panel for troubleshooting memory leaks."
    }
