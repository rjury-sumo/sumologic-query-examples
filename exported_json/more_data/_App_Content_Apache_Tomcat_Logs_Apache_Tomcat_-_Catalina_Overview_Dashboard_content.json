      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\",\"type\":\"column\"},\"series\":{},\"axes\":{\"axisX\":{\"title\":\"\"},\"axisY\":{\"title\":\" \",\"unit\":{\"value\":\"s\",\"isCustom\":false}}},\"legend\":{\"enabled\":false},\"overrides\":[{\"series\":[\"avg_startuptime_sec\"],\"queries\":[],\"properties\":{\"name\":\"avg startuptime sec\"}}]}",
