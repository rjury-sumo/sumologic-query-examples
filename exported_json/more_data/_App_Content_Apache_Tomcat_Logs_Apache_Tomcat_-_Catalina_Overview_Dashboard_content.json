      "key": "panel026C1714BAD21B4A",
      "title": "Server State Events Over Time",
      "visualSettings": "{\"general\":{\"mode\":\"timeSeries\",\"type\":\"column\",\"displayType\":\"stacked\"},\"series\":{\"A_shutdown\":{\"visible\":true},\"A_startup\":{\"visible\":true}},\"legend\":{\"enabled\":false},\"overrides\":[],\"color\":{\"family\":\"Categorical Dark\"}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = *tomcat* webserver_system=tomcat webserver_farm={{webserver_farm}} (shutdown or startup) | json \"log\" as _rawlog nodrop \n| if (isEmpty(_rawlog), _raw, _rawlog) as _raw\n| if (_raw matches \"*INFO: A valid shutdown command was received via the shutdown port. Stopping the Server instance.*\",1,0) as shutdown\n| if (_raw matches \"*INFO: Server startup in*\",1,0) as startup\n| timeslice 1d\n| sum (shutdown) as shutdown, sum(startup) as startup by _timeslice",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
