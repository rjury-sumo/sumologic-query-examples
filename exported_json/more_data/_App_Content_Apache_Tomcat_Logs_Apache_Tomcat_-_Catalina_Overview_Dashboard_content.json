      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory = *tomcat* webserver_system=tomcat webserver_farm={{webserver_farm}} startup | json \"log\" as _rawlog nodrop \n| if (isEmpty(_rawlog), _raw, _rawlog) as _raw\n| parse \"INFO: Server startup in * ms\" as startuptime\n| startuptime/1000 as startuptime_ms\n| timeslice 1d\n| avg(startuptime_ms) as avg_startuptime_sec by _timeslice",
