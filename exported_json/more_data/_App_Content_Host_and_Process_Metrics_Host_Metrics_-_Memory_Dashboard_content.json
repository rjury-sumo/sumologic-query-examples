    {
      "id": null,
      "key": "panelPANE-5A9E754894CAA945",
      "title": "Buffers vs Cached vs Swap Cached",
      "visualSettings": "{\"general\":{\"mode\":\"TextPanel\",\"type\":\"text\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"series\":{},\"text\":{\"format\":\"markdown\"},\"legend\":{\"enabled\":false}}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "TextPanel",
      "text": "* Buffer Cache Memory: Memory in the buffer cache that holds temporary storage for raw disk blocks. \n* Cache Memory: Memory in the page cache (Includes Disk Cache and Shared Memory)\n* Swap Cached Memory: Memory present within main memory, but also in the swapfile. If memory is needed, this area does not need to be swapped out again because it is already in the swapfile. This saves I/O and increases performance if the machine runs out of memory.\n"
    },
