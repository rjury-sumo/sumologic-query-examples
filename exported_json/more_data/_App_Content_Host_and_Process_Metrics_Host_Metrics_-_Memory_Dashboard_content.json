      "visualSettings": "{\"general\":{\"mode\":\"TextPanel\",\"type\":\"text\",\"displayType\":\"default\"},\"title\":{\"fontSize\":14},\"series\":{},\"text\":{\"alignment\":\"left\",\"format\":\"markdown\"},\"legend\":{\"enabled\":false}}",
