      "queries": [
        {
          "transient": false,
          "queryString": "_index=sumologic_volume _sourceCategory = \"sourcecategory_and_tier_volume\"\n| parse regex \"(?<data>\\{[^\\{]+\\})\" multi\n| json field=data \"field\",\"dataTier\",\"sizeInBytes\",\"count\" as sourcecategory, dataTier, bytes, count\n|where dataTier matches \"{{Tier}}\"\n| bytes/1Gi as gbytes \n| sum(gbytes) as gbytes by sourceCategory\n| round(gbytes,2) as gbytes\n| ((queryEndTime() - queryStartTime())/(1000*60*60*24)) as duration_in_day\n| gbytes / duration_in_day as %\"GB/Day\"\n| round(%\"GB/Day\",2) as %\"GB/Day\"\n| top 5 sourceCategory by gbytes, %\"GB/Day\"",
          "queryType": "Logs",
          "queryKey": "A",
