      "visualSettings": "{\"title\":{\"fontSize\":14},\"general\":{\"type\":\"column\",\"displayType\":\"stacked\",\"fillOpacity\":1,\"mode\":\"timeSeries\"},\"axes\":{\"axisX\":{\"hideLabels\":false,\"title\":\"\",\"titleFontSize\":12,\"labelFontSize\":12},\"axisY\":{\"hideLabels\":false,\"title\":\"\",\"titleFontSize\":12,\"labelFontSize\":12,\"logarithmic\":false,\"gridColor\":\"\",\"minimum\":null,\"maximum\":null}},\"legend\":{\"enabled\":true,\"verticalAlign\":\"right\",\"fontSize\":12,\"maxHeight\":50,\"showAsTable\":true,\"wrap\":true},\"color\":{\"family\":\"Categorical Default\"},\"thresholdsSettings\":{\"fillRemainingGreen\":false,\"showThresholds\":false,\"numberThresholds\":{\"warning\":{\"display\":true,\"comparator\":\"greater_or_equal\",\"value\":80},\"critical\":{\"display\":true,\"comparator\":\"greater_or_equal\",\"value\":100}}},\"overrides\":[{\"series\":[\"blocked by administrator\"],\"queries\":[],\"properties\":{\"axisYType\":\"primary\",\"type\":\"column\"}},{\"series\":[\"dangerous\"],\"queries\":[],\"properties\":{\"axisYType\":\"primary\",\"type\":\"column\"}},{\"series\":[\"suspicious\"],\"queries\":[],\"properties\":{\"axisYType\":\"primary\",\"type\":\"column\"}},{\"series\":[\"highly suspicious\"],\"queries\":[],\"properties\":{\"axisYType\":\"primary\",\"type\":\"column\"}},{\"series\":[\"untested\"],\"queries\":[],\"properties\":{\"axisYType\":\"primary\",\"type\":\"column\"}}]}",
      "keepVisualSettingsConsistentWithParent": true,
      "panelType": "SumoSearchPanel",
      "queries": [
        {
          "transient": false,
          "queryString": "_sourceCategory={{Logsdatasource}}  \n| extract \"CEF:\\s*0\\|(?<Device_Vendor>.*)\\|(?<Device_Product>.*)\\|(?<Device_Version>.*)\\|(?<Signature_ID>.*)\\|(?<Name>.*)\\|(?<Severity>.*)\\|(?<Extension>.*)\" \n| where signature_id >= 5000000 AND signature_id <= 5999999 | \"Web Reputation\" as deepsecuritysource\n| parse regex field=extension \"msg=(?<Message>.+?)$\" nodrop \n| if (message matches \"Blocked By Administrator\", \"Blocked\", message) as message\n| timeslice 30m\n|where if (\"{{severity}}\" = \"*\", true, severity matches \"{{severity}}\") AND if (\"{{signature_id}}\" = \"*\", true, signature_id matches \"{{signature_id}}\") AND if (\"{{name}}\" = \"*\", true, name matches \"{{name}}\")\n|count _timeslice, message | transpose row _timeslice column message",
          "queryType": "Logs",
          "queryKey": "A",
          "metricsQueryMode": null,
          "metricsQueryData": null,
          "tracesQueryData": null,
          "spansQueryData": null,
          "parseMode": "Auto",
          "timeSource": "Message",
          "outputCardinalityLimit": 1000
